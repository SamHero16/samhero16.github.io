# Number of samples
n = 1000000
# Generate X
X = rnorm(n)
# Generate Y
Y <- 0.5 * X + sqrt(1 - 0.5^2) * rnorm(n)
# Correlation between X and Y
cor(X, Y)
# Linear model
lm(Y ~ X)
# Mean and standard deviation of X + Y
mean(X + Y)
sd(X + Y)
# Correct qnorm call using the correct standard deviation
qnorm(1, mean(X - Y), sd(X - Y))  # sd(X - Y) is 1
# Correct qnorm call using the correct standard deviation
qnorm(-, mean(X - Y), sd(X - Y))  # sd(X - Y) is 1
# Correct qnorm call using the correct standard deviation
qnorm(0, mean(X - Y), sd(X - Y))  # sd(X - Y) is 1
# Correct qnorm call using the correct standard deviation
qnorm(1, mean(X - Y), sd(X - Y))  # sd(X - Y) is 1
# Correct qnorm call using the correct standard deviation
pnorm(1, mean(X - Y), sd(X - Y))  # sd(X - Y) is 1
# Correct qnorm call using the correct standard deviation
pnorm(0, mean(X - Y), sd(X - Y))  # sd(X - Y) is 1
pnorm(0, mean(X - Y), sd(X - Y))
Y <- 0.5 * X + rnorm(n)
cor(X, Y)
# Number of samples
